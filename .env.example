NODE_ENV=development
# Set true for HTTPS. For the temporary HTTP-by-IP test entry, set false.
APP_SECURE_COOKIES=false
APP_DATABASE_PATH=./data/app.sqlite
OBJECT_STORAGE_DRIVER=local
LOCAL_OBJECT_STORAGE_PATH=./data/objects
ADMIN_EMAIL=admin@example.com

# Registration requires working SMTP. Supply SMTP_PASSWORD through the server
# secret store (never commit it). Port 465 uses implicit TLS; other ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=

# Provider reference configuration. Enter the API key only through the
# authenticated admin provider settings; never put it in this file.
GENERATION_PROVIDER_NAME=xAI
GENERATION_PROVIDER_ENDPOINT=https://coderapi.vip/v1/images/generations
GENERATION_PROVIDER_MODEL=grok-imagine-image-2.0

# Production also requires APP_ENCRYPTION_KEY, COS_SECRET_ID, COS_SECRET_KEY,
# COS_BUCKET and COS_REGION. Keep their values in the deployment secret store.
