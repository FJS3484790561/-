{
  "name": "ai-interior-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "api:start": "node server/start-api.js",
    "data:migrate": "node server/persistence/data-command.js migrate",
    "data:verify": "node server/persistence/data-command.js verify",
    "data:backup": "node server/persistence/data-command.js backup",
    "data:restore-check": "node server/persistence/data-command.js restore-check",
    "preview": "vite preview",
    "lint": "eslint .",
    "qa:browser": "node tests/user-surfaces.playwright.mjs && node tests/admin-surface.playwright.mjs",
    "typecheck": "node -e \"console.log('TYPECHECK: N/A - frontend uses JavaScript; Vite build is the syntax and module check')\"",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^12.2.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "lucide-react": "latest",
    "nodemailer": "^10.0.1",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "playwright": "^1.62.1"
  }
}
